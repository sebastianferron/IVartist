{
  "name": "ivartist-api",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [{ "name": "IVARTIST_STATE", "class_name": "IvartistState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IvartistState"] }],
  "r2_buckets": [{ "binding": "IVARTIST_MEDIA", "bucket_name": "ivartist-private-media" }],
  "triggers": { "crons": ["* * * * *"] }
}
